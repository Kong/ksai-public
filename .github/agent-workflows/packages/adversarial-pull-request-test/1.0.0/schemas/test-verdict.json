{
  "type": "object",
  "required": ["outcome", "summary", "criteria", "probes", "findings"],
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "enum": ["pass", "defect", "ambiguous_requirement", "infra_failure", "insufficient_evidence"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "hypothesis_results": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "required": ["name", "kind", "command", "observed", "passed"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 2000},
        "kind": {"enum": ["readiness", "product"]},
        "command": {"type": "string", "minLength": 1, "maxLength": 2000},
        "observed": {"type": "string", "minLength": 1, "maxLength": 2000},
        "passed": {"type": "boolean"}
      }
    },
    "finding": {
      "type": "object",
      "required": ["title", "reproduction", "evidence"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 2000},
        "file": {"type": "string", "minLength": 1, "maxLength": 2000},
        "line": {"type": "integer"},
        "reproduction": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "hypothesis": {
      "type": "object",
      "required": ["id", "outcome", "reason", "probe_names"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 2000},
        "outcome": {"enum": ["confirmed", "refuted", "insufficient_evidence"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "probe_names": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "finding_index": {"type": "integer", "minimum": 0}
      }
    }
  }
}
