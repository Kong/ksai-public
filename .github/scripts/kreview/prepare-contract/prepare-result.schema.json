{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The closed prepare task result output",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "task_id", "body_digest", "binding_digest", "runtime_commit", "profile_digest", "status"],
  "properties": {
    "api_version": { "const": "ksai.konghq.com/stage-prepare-result/v1alpha1" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "body_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runtime_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "profile_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "enum": ["ready", "failed", "cancelled", "deadline", "lease-lost"] }
  }
}
