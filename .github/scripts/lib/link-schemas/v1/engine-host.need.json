{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The engine asks the host for facts only the runner holds, or for a fresh run credential",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [{ "required": ["facts"] }, { "required": ["credential"] }],
  "properties": {
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" }
    },
    "credential": { "const": true }
  }
}
