{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The engine asks the host to start one sandboxed OpenCode session; what the model may be sent the host reads from the plan it relays",
  "type": "object",
  "additionalProperties": false,
  "required": ["session", "phase", "env"],
  "properties": {
    "session": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "phase": { "description": "The tool policy phase the host holds the session to", "type": "string", "pattern": "^[a-z][a-z-]{0,31}$" },
    "restarts": {
      "description": "The session this one runs again after the gateway lost it, so what was said to that one is said again",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "resumes": {
      "description": "The checkpoint whose signed export the host restores into this session",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "render": {
      "description": "The prompt and sink the engine rendered for this session, which the governor holds the signed render to",
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "sink"],
      "properties": {
        "prompt_id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
        "sink": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "binding_digest", "model", "variant", "allowed_tools", "disallowed_tools", "tools", "steps", "shell_timeout_ms", "deadline_at"],
      "properties": {
        "api_version": { "const": "ksai.konghq.com/session-policy/v1alpha1" },
        "binding_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
        "variant": { "enum": ["", "low", "medium", "high", "xhigh", "max"] },
        "allowed_tools": { "type": "string", "minLength": 1, "maxLength": 32768, "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$" },
        "disallowed_tools": { "type": "string", "minLength": 1, "maxLength": 32768, "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$" },
        "tools": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
        },
        "steps": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "shell_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "deadline_at": { "type": "string", "minLength": 20, "maxLength": 30, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" }
      }
    },
    "env": {
      "description": "Per-session settings the host passes on only where its own allowlist names them",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
          "value": { "type": "string", "maxLength": 4096 }
        }
      }
    }
  }
}
