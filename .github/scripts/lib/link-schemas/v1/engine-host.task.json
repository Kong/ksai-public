{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The engine asks the host to run one trusted task it ships, with arguments the task validates itself",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "args"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "args": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "value": { "type": "string", "maxLength": 1048576 }
        }
      }
    }
  }
}
