{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The host answers a need for a credential with a fresh ksai-cp OIDC token for this run",
  "type": "object",
  "additionalProperties": false,
  "required": ["token"],
  "properties": {
    "token": { "type": "string", "minLength": 20, "maxLength": 16384, "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }
  }
}
