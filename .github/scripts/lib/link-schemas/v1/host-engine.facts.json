{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The host answers a need with the facts it collected, and names those it holds none of",
  "type": "object",
  "additionalProperties": false,
  "required": ["facts", "missing"],
  "properties": {
    "facts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
          "value": { "type": "string", "maxLength": 3145728 }
        }
      }
    },
    "missing": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" }
    }
  }
}
