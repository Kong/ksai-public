{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The host signs back the challenge, which proves it holds the key pinned for this link",
  "type": "object",
  "additionalProperties": false,
  "required": ["challenge"],
  "properties": {
    "challenge": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" }
  }
}
