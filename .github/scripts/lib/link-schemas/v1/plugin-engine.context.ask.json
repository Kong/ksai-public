{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A governed tool asks for control plane context for this session",
  "type": "object",
  "additionalProperties": false,
  "required": ["session"],
  "properties": {
    "session": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "job_log_id": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "review_thread_cursor": { "type": "string", "minLength": 1, "maxLength": 512 },
    "history_kind": { "type": "string", "enum": ["reviews", "findings", "plan", "recovery", "knowledge"] },
    "history_cursor": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
