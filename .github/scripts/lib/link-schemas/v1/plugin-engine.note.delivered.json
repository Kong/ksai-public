{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The note with this id reached the model on a tool result",
  "type": "object",
  "additionalProperties": false,
  "required": ["session"],
  "properties": {
    "session": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" }
  }
}
