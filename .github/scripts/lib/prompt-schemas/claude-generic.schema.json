{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksai.invalid/prompts/schemas/claude-generic.schema.json",
  "title": "Generic agent request input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request",
    "workspace"
  ],
  "properties": {
    "request": {
      "type": "string",
      "maxLength": 262144
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
