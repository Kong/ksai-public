{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksai.invalid/prompts/schemas/pr-test-environment.schema.json",
  "title": "Owned pull request test environment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record"
  ],
  "properties": {
    "record": {
      "$ref": "#/$defs/record"
    }
  },
  "$defs": {
    "description": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "command",
        "task"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "detail",
        "detail_normalized_bytes",
        "detail_normalized_sha256",
        "detail_source_bytes",
        "detail_source_sha256",
        "detail_transformations",
        "health",
        "kind",
        "name",
        "ok",
        "pid",
        "started_by"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/description"
        },
        "detail": {
          "type": "string",
          "maxLength": 297
        },
        "detail_normalized_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1188
        },
        "detail_normalized_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "detail_source_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "detail_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "detail_transformations": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ansi-csi-deleted",
              "surrounding-whitespace-deleted",
              "leading-lines-deleted",
              "leading-code-points-deleted"
            ]
          }
        },
        "health": {
          "$ref": "#/$defs/health"
        },
        "kind": {
          "type": "string",
          "enum": [
            "make",
            "mise"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "ok": {
          "type": "boolean"
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "selected_as": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "started_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "health": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "ready",
        "status",
        "url"
      ],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "ready": {
          "type": "boolean"
        },
        "status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environments",
        "host"
      ],
      "properties": {
        "environments": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/environment"
          }
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00\\r\\n]+$"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
