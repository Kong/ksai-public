{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksai.invalid/prompts/schemas/review-stage-correction.schema.json",
  "title": "Governed review finding correction input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "stage"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object"
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "problems"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^discover-[a-z0-9-]+$",
          "maxLength": 128
        },
        "problems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding",
              "problem"
            ],
            "properties": {
              "finding": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "problem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    }
  }
}
