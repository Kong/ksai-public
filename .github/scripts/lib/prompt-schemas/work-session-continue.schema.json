{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksai.invalid/prompts/schemas/work-session-continue.schema.json",
  "title": "Governed Work session continuation",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_prompt", "handoff", "knowledge"],
  "allOf": [{
    "if": {"required": ["followup"]},
    "then": {"properties": {"handoff": {"required": ["followup_actor", "followup_actor_id", "followup_source"]}}},
    "else": {"properties": {"handoff": {"not": {"anyOf": [{"required": ["followup_actor"]}, {"required": ["followup_actor_id"]}, {"required": ["followup_source"]}]}}}}
  }],
  "properties": {
    "followup": {"type": "string", "minLength": 1, "maxLength": 65536},
    "base_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "session_id", "source_session_id", "source_prompt_id", "source_render_digest", "source_head_sha", "current_head_sha", "checkpoint"],
      "properties": {
        "followup_actor": {"type": "string", "minLength": 1, "maxLength": 256},
        "followup_actor_id": {"type": "integer", "minimum": 1},
        "followup_source": {"type": "string", "minLength": 1, "maxLength": 4096},
        "action": {"enum": ["continue", "restart"]},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_session_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_prompt_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 160, "not": {"const": "runtime.work-session-continue"}},
        "source_render_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_head_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40})?$"},
        "current_head_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40})?$"},
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "id"],
          "properties": {
            "status": {"enum": ["restored", "fallback", "none"]},
            "id": {"type": "string", "maxLength": 128}
          }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "session_id", "built_at", "items"],
      "properties": {
        "version": {"const": "work-context/v1"},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "built_at": {"type": "string", "minLength": 1, "maxLength": 64},
        "head_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40})?$"},
        "next_review_thread_cursor": {"type": "string", "minLength": 1, "maxLength": 512},
        "next_history_cursor": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "items": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source", "trust", "digest", "observed_at", "fresh", "text"],
            "properties": {
              "kind": {"type": "string", "minLength": 1, "maxLength": 128},
              "source": {"type": "string", "minLength": 1, "maxLength": 4096},
              "trust": {"enum": ["external", "operator-approved", "model-observed", "control-plane"]},
              "head_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40})?$"},
              "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "observed_at": {"type": "string", "minLength": 1, "maxLength": 64},
              "fresh": {"type": "boolean"},
              "text": {"type": "string", "maxLength": 49152}
            }
          }
        },
        "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 512}}
      }
    }
  }
}
