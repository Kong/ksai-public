{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksai.invalid/prompts/schemas/work-session-start.schema.json",
  "title": "Governed Work session start",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_prompt", "knowledge"],
  "properties": {
    "base_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "session_id", "built_at", "items"],
      "properties": {
        "version": {"const": "work-context/v1"},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "built_at": {"type": "string", "minLength": 1, "maxLength": 64},
        "head_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40})?$"},
        "next_review_thread_cursor": {"type": "string", "minLength": 1, "maxLength": 512},
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source", "trust", "digest", "observed_at", "fresh", "text"],
            "properties": {
              "kind": {"type": "string", "minLength": 1, "maxLength": 128},
              "source": {"type": "string", "minLength": 1, "maxLength": 4096},
              "trust": {"enum": ["external", "operator-approved", "model-observed", "control-plane"]},
              "head_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40})?$"},
              "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "observed_at": {"type": "string", "minLength": 1, "maxLength": 64},
              "fresh": {"type": "boolean"},
              "text": {"type": "string", "maxLength": 49152}
            }
          }
        },
        "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 512}}
      }
    }
  }
}
